  "components": {
    "schemas": {
      "ConsentChoice": {
        "type": "string",
        "enum": [
          "WAIT",
          "SWAP",
          "CANCEL"
        ],
        "title": "ConsentChoice"
      },
      "ConsentSubmitRequest": {
        "properties": {
          "order_id": {
            "type": "integer",
            "title": "Order Id"
          },
          "choice": {
            "$ref": "#/components/schemas/ConsentChoice"
          },
          "swapped_sku": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Swapped Sku"
          },
          "locale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "choice"
        ],
