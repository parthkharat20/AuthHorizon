# AuthHorizon Environment Configuration Template
# Copy this file to .env and insert your sandbox credentials.
# DO NOT COMMIT .env TO VERSION CONTROL.

# PayPal Developer Sandbox Credentials
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Mode switch: set to "true" for mock gateway, "false" for real PayPal sandbox
USE_MOCK_PAYPAL=false

# Google Gemini API Key (for multilingual supplier notice parsing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Key (T3 fallback provider)
GROQ_API_KEY=your_groq_api_key_here

# Frontend URL (for PayPal redirect context)
FRONTEND_URL=http://localhost:8000

# Server Port
PORT=8000
